# Force LF line endings in the working tree for every text file, on every OS.
# This overrides any local core.autocrlf / core.eol so a clone on Windows still
# checks out LF — the service and its scripts run on Linux.

* text=auto eol=lf

# Explicit text types (belt-and-braces alongside text=auto).
*.py        text eol=lf
*.pyi       text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf
*.sh        text eol=lf
*.service   text eol=lf
*.sql       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.env       text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
VERSION     text eol=lf

# Extensionless executable wrappers (install/update): keep them text + LF.
install     text eol=lf
update      text eol=lf

# Binary types: never normalize or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.gz    binary
*.tar   binary
*.zst   binary
*.dump  binary
