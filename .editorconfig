# EditorConfig is the cross-editor source of truth for whitespace/encoding style.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,css,html,json,yml,yaml,toml}]
indent_size = 2

# Markdown treats trailing whitespace as a hard line break, so do not strip it.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
